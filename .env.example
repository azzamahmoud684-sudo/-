# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Push VAPID Keys for Real Android Push Notifications
# The application comes pre-configured with a valid VAPID keypair.
# To use your own keys from Firebase Console (Project Settings -> Cloud Messaging -> Web Push certificates):
# 1. Generate a key pair in Firebase Console.
# 2. Paste the Public Key and Private Key below:
VAPID_PUBLIC_KEY="BNZ2K6EyIYxITp4N0Gf547OroRMvzghNEoHZJ-zlGlYzR-4kMUkCrcLxwx0Vhhh9gUAGnaUfXIVY7fV5AtTjDX4"
VAPID_PRIVATE_KEY="pk1HVHhQgOG0slubtYEyKEZ4RSBQ6jwjuqwedERu5g4"
VAPID_SUBJECT="mailto:support@ouns.app"
VITE_VAPID_PUBLIC_KEY="BNZ2K6EyIYxITp4N0Gf547OroRMvzghNEoHZJ-zlGlYzR-4kMUkCrcLxwx0Vhhh9gUAGnaUfXIVY7fV5AtTjDX4"
